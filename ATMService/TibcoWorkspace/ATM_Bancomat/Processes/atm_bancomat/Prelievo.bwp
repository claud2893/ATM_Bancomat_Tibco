                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+08024712-bf71-49be-a041-4ba87feb76a4+input&quot; xmlns:tns2=&quot;http://www.example.org/prelievo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns5:jdbcUpdateActivityInput>&lt;IMPORTO>&lt;xsl:value-of select=&quot;$ParseXml/tns2:importo_operazione&quot;/>&lt;/IMPORTO>&lt;PIN>&lt;xsl:value-of select=&quot;$ParseXml/tns2:pin&quot;/>&lt;/PIN>&lt;NOME>&lt;xsl:value-of select=&quot;$ParseXml/tns2:nome&quot;/>&lt;/NOME>&lt;COGNOME>&lt;xsl:value-of select=&quot;$ParseXml/tns2:cognome&quot;/>&lt;/COGNOME>&lt;/tns5:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
