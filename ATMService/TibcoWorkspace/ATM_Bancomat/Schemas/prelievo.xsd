<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/prelievo" xmlns:tns="http://www.example.org/prelievo" elementFormDefault="qualified">

    <element name="prelievo" type="tns:PrelievoType"></element>

    <complexType name="PrelievoType">
    	<sequence>
    		<element name="nome" type="string"></element>
    		<element name="cognome" type="string"></element>
    		<element name="pin" type="int"></element>
    		<element name="importo_operazione" type="int"></element>
    	</sequence>
    </complexType>
</schema>